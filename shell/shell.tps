    <color-palette name="Shell style — Categorical" type="regular">
      <color>#e03a35</color>
      <color>#2f6aae</color>
      <color>#b08500</color>
      <color>#a3a3a3</color>
      <color>#7b7b7b</color>
    </color-palette>
    <color-palette name="Shell style — Sequential" type="ordered-sequential">
      <color>#96b6e4</color>
      <color>#709ad6</color>
      <color>#4c7ec3</color>
      <color>#3063a9</color>
      <color>#1e4a85</color>
    </color-palette>
    <color-palette name="Shell style — Diverging" type="ordered-diverging">
      <color>#b32322</color>
      <color>#dd574e</color>
      <color>#ea988f</color>
      <color>#e4e4e4</color>
      <color>#93b3e1</color>
      <color>#5a87c8</color>
      <color>#2d5da0</color>
