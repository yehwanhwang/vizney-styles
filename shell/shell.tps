<?xml version='1.0'?>
<!-- Shell style · VIZNEY STYLES · 06. Paste the color-palette elements into My Tableau Repository/Preferences.tps
     (inside <preferences>) and restart Tableau Desktop. Generated by tools/package.py from tokens.json. -->
