<!-- Netflix style · VIZNEY STYLES · 03. Paste the color-palette elements into My Tableau Repository/Preferences.tps
     (inside <preferences>) and restart Tableau Desktop. Generated by tools/package.py from tokens.json. -->
<workbook>
  <preferences>
    <color-palette name="Netflix style — Categorical" type="regular">
      <color>#f0313b</color>
      <color>#6a88f2</color>
      <color>#595959</color>
      <color>#808080</color>
    </color-palette>
    <color-palette name="Netflix style — Sequential" type="ordered-sequential">
      <color>#9e2027</color>
      <color>#c4262f</color>
      <color>#f0313b</color>
      <color>#ff6b72</color>
      <color>#ffa3a7</color>
    </color-palette>
    <color-palette name="Netflix style — Diverging" type="ordered-diverging">
      <color>#ffa3a7</color>
      <color>#f0313b</color>
      <color>#9e2027</color>
      <color>#3a3a3a</color>
      <color>#3f55a8</color>
      <color>#6a88f2</color>
      <color>#b3c3f9</color>
    </color-palette>
  </preferences>
</workbook>
