      <color>#3d8af7</color>
      <color>#d5691f</color>
      <color>#14a06a</color>
      <color>#58585b</color>
      <color>#959599</color>
    </color-palette>
    <color-palette name="NASA style — Sequential" type="ordered-sequential">
      <color>#1d52ad</color>
      <color>#2d6fd6</color>
      <color>#4a90f7</color>
      <color>#82b3ff</color>
      <color>#bcd6ff</color>
    </color-palette>
    <color-palette name="NASA style — Diverging" type="ordered-diverging">
      <color>#98bdf5</color>
      <color>#5189e0</color>
      <color>#2b5aa6</color>
      <color>#444447</color>
      <color>#91491a</color>
      <color>#c96a2b</color>
