<?xml version='1.0'?>
<!-- Anthropic style · Vizney Styles 01. Paste the color-palette elements into My Tableau Repository/Preferences.tps
     (inside <preferences>) and restart Tableau Desktop. Generated by tools/package.py from tokens.json. -->
<workbook>
  <preferences>
    <color-palette name="Anthropic style — Categorical" type="regular">
      <color>#4f86c4</color>
      <color>#b8456e</color>
      <color>#a8862a</color>
      <color>#8f8d86</color>
      <color>#b0aea5</color>
    </color-palette>
    <color-palette name="Anthropic style — Sequential" type="ordered-sequential">
      <color>#8ab5e6</color>
      <color>#5b97db</color>
      <color>#367ac2</color>
      <color>#215e9d</color>
      <color>#1d446e</color>
    </color-palette>
    <color-palette name="Anthropic style — Diverging" type="ordered-diverging">
      <color>#225994</color>
      <color>#5078a7</color>
      <color>#7b97b9</color>
      <color>#b8b5aa</color>
      <color>#bf8091</color>
      <color>#ac5571</color>
      <color>#972552</color>
    </color-palette>
  </preferences>
</workbook>
