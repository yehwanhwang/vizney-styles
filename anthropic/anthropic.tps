<?xml version='1.0'?>
<!-- Anthropic style · Vizney Styles 01. Paste the color-palette elements into My Tableau Repository/Preferences.tps
     (inside <preferences>) and restart Tableau Desktop. Generated by tools/package.py from tokens.json. -->
<workbook>
  <preferences>
    <color-palette name="Anthropic style — Categorical" type="regular">
      <color>#d97757</color>
      <color>#6953a0</color>
      <color>#0d9298</color>
      <color>#8f8d86</color>
      <color>#73726c</color>
    </color-palette>
    <color-palette name="Anthropic style — Sequential" type="ordered-sequential">
      <color>#e79176</color>
      <color>#d47150</color>
      <color>#ba5432</color>
      <color>#9b3d1d</color>
      <color>#782d12</color>
    </color-palette>
    <color-palette name="Anthropic style — Diverging" type="ordered-diverging">
      <color>#00636a</color>
      <color>#00797f</color>
      <color>#469094</color>
      <color>#9f9b93</color>
      <color>#b26e58</color>
      <color>#a14e33</color>
      <color>#8f2c01</color>
    </color-palette>
  </preferences>
</workbook>
