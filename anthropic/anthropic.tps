  <preferences>
    <color-palette name="Anthropic style — Categorical" type="regular">
      <color>#eb6834</color>
      <color>#1baf7a</color>
      <color>#6150d3</color>
      <color>#73726c</color>
      <color>#c2c0b6</color>
      <color>#87867f</color>
      <color>#b0aea5</color>
    </color-palette>
    <color-palette name="Anthropic style — Sequential" type="ordered-sequential">
      <color>#7db2f0</color>
      <color>#4f90dc</color>
      <color>#2f74c2</color>
      <color>#1a5ba0</color>
      <color>#16416f</color>
    </color-palette>
    <color-palette name="Anthropic style — Diverging" type="ordered-diverging">
      <color>#aa4518</color>
      <color>#dc6c40</color>
      <color>#eb9574</color>
      <color>#d1cfc5</color>
