    "#a8862a",
    "#8f8d86",
    "#215e9d",
    "#5078a7",
    "#ac5571",
    "#b0aea5"
  ],
  "background": "#faf9f5",
  "foreground": "#141413",
  "tableAccent": "#141413",
  "good": "#4e7a30",
  "neutral": "#87867f",
  "bad": "#b0453b",
  "maximum": "#1d446e",
  "center": "#367ac2",
  "minimum": "#8ab5e6",
  "null": "#e8e6dc",
  "textClasses": {
    "callout": {
      "fontFace": "Inter",
      "fontSize": 28,
      "color": "#141413"
    },
    "title": {
      "fontFace": "Inter",
      "fontSize": 12,
      "color": "#141413"
    },
    "header": {
      "fontFace": "Inter",
      "fontSize": 11,
      "color": "#5e5d59"
    },
    "label": {
      "fontFace": "Inter",
      "fontSize": 10,
      "color": "#5e5d59"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "fontFamily": "Inter",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#3d3d3a"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#f5f4ed"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#f5f4ed"
              }
            },
            "foreground": {
              "solid": {
                "color": "#5e5d59"
              }
            }
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Inter",
            "fontSize": 12,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#141413"
              }
            },
            "alignment": "left"
          }
        ],
        "plotArea": [
          {
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#87867f"
              }
            },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#e8e6dc"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#87867f"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "position": "Top",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5e5d59"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#faf9f5"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#faf9f5"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  },
  "_notes": [
    "Fonts: install Inter on authoring and viewing machines, or substitute Segoe UI.",
    "Use only the first four dataColors for categories (three hues plus gray Other); the rest exist because Power BI needs a longer list. Clay is not a data color.",
    "Title a visual with the finding (a sentence), put the method in a subtitle, and label line ends instead of showing a legend.",
    "Generated by tools/package.py from tokens.json."
  ]
