{
  "name": "Anthropic style (Vizney Styles 01)",
  "dataColors": [
    "#eb6834",
    "#1baf7a",
    "#6150d3",
    "#73726c",
    "#c2c0b6",
    "#87867f",
    "#1a5ba0",
    "#dc6c40",
    "#4f90dc",
    "#b0aea5"
  ],
  "background": "#faf9f5",
  "foreground": "#141413",
  "tableAccent": "#141413",
  "good": "#4a7b00",
  "neutral": "#87867f",
  "bad": "#b0453b",
  "maximum": "#16416f",
  "center": "#2f74c2",
  "minimum": "#7db2f0",
  "null": "#e8e6dc",
  "textClasses": {
    "callout": {
      "fontFace": "Inter",
      "fontSize": 28,
      "color": "#141413"
    },
    "title": {
      "fontFace": "Inter",
      "fontSize": 12,
      "color": "#141413"
    },
    "header": {
      "fontFace": "Inter",
      "fontSize": 11,
      "color": "#5e5d59"
    },
    "label": {
      "fontFace": "Inter",
      "fontSize": 10,
      "color": "#5e5d59"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "fontFamily": "Inter",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#3d3d3a"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#faf9f5"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#141413"
              }
            },
            "radius": 0
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#faf9f5"
              }
            },
            "foreground": {
              "solid": {
                "color": "#5e5d59"
              }
            }
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Inter",
            "fontSize": 12,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#141413"
              }
            },
            "alignment": "left"
          }
        ],
        "plotArea": [
          {
            "color": {
              "solid": {
                "color": "#faf9f5"
              }
            },
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#73726c"
              }
            },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#e8e6dc"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#73726c"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "position": "Top",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5e5d59"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#faf9f5"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#faf9f5"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  },
  "_notes": [
    "Fonts: install Inter on authoring and viewing machines, or substitute Segoe UI.",
    "Series: the first 3 dataColors are the category hues in order (the first is the subject), the next 2 are neutral references such as rivals or benchmarks, then gray Other. Keep categories to three hues plus gray; the remaining colors only exist because Power BI needs a longer list. The brand accent is not a data color.",
    "Title a visual with the finding (a sentence), put the method in a subtitle, and label line ends instead of showing a legend.",
    "Generated by tools/package.py from tokens.json."
  ]
}
