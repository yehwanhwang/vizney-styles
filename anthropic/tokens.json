      "cardTitle": { "size": "15px", "weight": 500, "lineHeight": "22px", "family": "sans" },
      "body":      { "size": "14px", "weight": 400, "lineHeight": 1.5, "family": "sans" },
      "label":     { "size": "13px", "weight": 400, "lineHeight": 1.4, "family": "sans" },
      "caption":   { "size": "12.5px", "weight": 400, "lineHeight": 1.5, "family": "sans" },
      "axis":      { "size": "11px", "weight": 400, "family": "sans" },
      "tableHead": { "size": "11.5px", "weight": 400, "letterSpacing": "0.06em", "transform": "uppercase", "family": "sans" },
      "mono":      { "size": "13px", "weight": 400, "family": "mono" }
    }
  },

  "radius": { "card": "16px", "pill": "999px", "button": "10px", "tooltip": "8px", "cover": "2px 4px 4px 2px" },
  "spacing": { "page": "32px", "gap": "16px", "card": "24px", "row": "8px 0", "bandPadding": "26px 32px 22px" },
  "layout": { "maxWidth": "1400px", "columns": 12, "breakpoints": { "wide": 1360, "mid": 1024, "narrow": 900, "phone": 640 } },
  "motion": { "ease": "cubic-bezier(.165,.84,.44,1)", "draw": "1.2s", "fade": "0.45s" },

  "tools": {
    "tableau": { "palettes": "anthropic.tps", "fonts": "Tableau Book for text, Source Serif 4 only if installed on the server; figures regular weight" },
    "powerbi": { "theme": "powerbi-theme.json", "fontFamily": "Inter", "fallback": "Segoe UI" },
    "web": { "css": "tokens.css" }
  }
