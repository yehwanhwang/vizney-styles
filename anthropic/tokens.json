{
  "name": "Anthropic style",
  "slug": "anthropic",
  "number": 1,
  "words": { "en": "Ivory, Editorial, Quiet", "ko": "아이보리, 에디토리얼, 고요함" },
  "source": ["https://www.anthropic.com", "https://claude.com"],
  "sample": { "url": "https://styles.vizney.com/anthropic/", "topic": "Monthly sales report of a fictional publisher" },

  "colors": {
    "canvas":       { "hex": "#faf9f5", "role": "page background, tooltips, hollow markers" },
    "card":         { "hex": "#f0eee6", "role": "cards; no border, no shadow" },
    "card-strong":  { "hex": "#e8e6dc", "role": "active tab, secondary button, bar tracks" },
    "pill":         { "hex": "#f5f4ed", "role": "pills and the language toggle" },
    "band":         { "hex": "#141413", "role": "the one dark surface for a detail table" },
    "band-hover":   { "hex": "#1f1e1d", "role": "row hover on the band" },
    "ink":          { "hex": "#141413", "role": "figures, titles, primary control" },
    "ink-2":        { "hex": "#30302e", "role": "primary control hover, secondary button text" },
    "body":         { "hex": "#3d3d3a", "role": "running text" },
    "text-2":       { "hex": "#5e5d59", "role": "labels, captions, legends, statement words" },
    "text-3":       { "hex": "#73726c", "role": "axis ticks, the comparison series" },
    "muted":        { "hex": "#87867f", "role": "rank numbers, small captions" },
    "on-dark":      { "hex": "#faf9f5", "role": "text on the band" },
    "on-dark-2":    { "hex": "#9c9a92", "role": "captions and secondary cells on the band" },
    "hair":         { "hex": "#e8e6dc", "role": "row dividers, pill borders" },
    "hair-2":       { "hex": "#dedcd1", "role": "chart baseline, crosshair, tooltip border" },
    "hair-dark":    { "hex": "#30302e", "role": "dividers and bar tracks on the band" },
    "accent":       { "hex": "#d97757", "role": "the one accent: main series, outlined pills, primary emphasis" },
    "accent-deep":  { "hex": "#c46849", "role": "accent hover; bars on the band" },
    "good":         { "hex": "#2c6e4f", "role": "favourable change, text only" },
    "bad":          { "hex": "#a33d34", "role": "unfavourable change, text only" },
    "focus":        { "hex": "#2c84db", "role": "focus ring" }
  },

  "data": {
    "surface": "#f0eee6",
    "categorical": [
      { "name": "clay", "hex": "#d97757" },
      { "name": "plum", "hex": "#6953a0" },
      { "name": "teal", "hex": "#0d9298" }
    ],
    "other": "#8f8d86",
    "comparison": "#73726c",
    "sequential": ["#e79176", "#d47150", "#ba5432", "#9b3d1d", "#782d12"],
    "diverging": ["#00636a", "#00797f", "#469094", "#9f9b93", "#b26e58", "#a14e33", "#8f2c01"],
    "status": { "good": "#2c6e4f", "bad": "#a33d34", "neutral": "#73726c" },
    "validation": {
      "tool": "dataviz validate_palette.js (OKLab)",
      "categorical": "clay/plum/teal: worst adjacent CVD ΔE 12.5, normal vision 19.1 on the card; clay is 2.7:1 on the card, so it is always labeled",
      "comparison": "clay vs #73726c: CVD ΔE 8.8, normal 17.5",
      "sequential": "one hue, monotone lightness, every step ≥ 0.06 ΔL apart, light end 2.1:1 on the card",
      "diverging": "teal and clay arms each pass the ordinal checks; poles ΔE 13.0 (CVD) / 21.7; neutral midpoint #9f9b93"
    }
  },

  "typography": {
    "serif": { "en": "Source Serif 4", "ko": "Noto Serif KR", "weights": [400, 500], "role": "statement, item titles, band heading, company name" },
    "sans":  { "en": "Inter", "ko": "Pretendard", "weights": [400, 500, 600], "role": "everything else" },
    "mono":  { "family": "JetBrains Mono", "weights": [400, 500], "role": "table numbers, dates, ranks, codes" },
    "links": {
      "google": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+KR:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&display=swap",
      "pretendard": "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    },
    "scale": {
      "statement": { "size": "clamp(26px, 2.9vw, 40px)", "weight": 400, "lineHeight": 1.28, "letterSpacing": "-0.012em", "family": "serif" },
