{
  "name": "Anthropic style",
  "slug": "anthropic",
  "number": 1,
  "words": { "en": "Ivory, Editorial, Quiet", "ko": "아이보리, 에디토리얼, 고요함" },
  "source": ["https://www.anthropic.com", "https://claude.com"],
  "sample": { "url": "https://styles.vizney.com/anthropic/", "topic": "Monthly sales report of a fictional publisher, laid out like an Anthropic research post" },

  "colors": {
    "canvas":       { "hex": "#faf9f5", "role": "page background (site gray-050)" },
    "card":         { "hex": "#f5f4ed", "role": "cards, pills, tertiary buttons (site gray-100); no border, no shadow" },
    "card-2":       { "hex": "#f0eee6", "role": "secondary panels, segmented-control track (site gray-150)" },
    "plot":         { "hex": "#ffffff", "role": "the white plot panel inside a figure card" },
    "tint":         { "hex": "#e4edf8", "role": "subject column of a table (light periwinkle)" },
    "ink":          { "hex": "#141413", "role": "titles, figures, table rules, primary button, footer, tooltips" },
    "ink-2":        { "hex": "#30302e", "role": "card descriptions, secondary button text" },
    "body":         { "hex": "#3d3d3a", "role": "running text, primary button hover" },
    "text-2":       { "hex": "#5e5d59", "role": "labels, captions, notes, meta values, end-label values" },
    "text-3":       { "hex": "#73726c", "role": "spare gray step" },
    "muted":        { "hex": "#87867f", "role": "figure labels, axis ticks, report id" },
    "cloud":        { "hex": "#b0aea5", "role": "reference and comparison lines (dashed)" },
    "hair":         { "hex": "#e8e6dc", "role": "dividers, pill borders, secondary button fill, gridlines" },
    "hair-2":       { "hex": "#dedcd1", "role": "key–value row rules, baseline, crosshair" },
    "on-dark":      { "hex": "#faf9f5", "role": "text on ink" },
    "on-dark-2":    { "hex": "#9c9a92", "role": "secondary text on ink" },
    "accent":       { "hex": "#d97757", "role": "clay — the one brand accent: badges and markers, never a data series" },
    "accent-deep":  { "hex": "#c6613f", "role": "clay interactive: badge text, a clay button if one is needed" },
    "good":         { "hex": "#4e7a30", "role": "favourable change, text only" },
    "bad":          { "hex": "#b0453b", "role": "unfavourable change, text only (site error #bf4d43 darkened one step for 13px text)" },
    "focus":        { "hex": "#2c84db", "role": "focus ring (site --color-focus)" }
  },

  "data": {
    "surface": "#ffffff",
    "categorical": [
      { "name": "sky",   "hex": "#4f86c4", "text": "#2e6cae" },
      { "name": "fig",   "hex": "#b8456e", "text": "#a63c62" },
      { "name": "amber", "hex": "#a8862a", "text": "#80661a" }
    ],
    "other": "#8f8d86",
    "comparison": "#b0aea5",
    "sequential": ["#8ab5e6", "#5b97db", "#367ac2", "#215e9d", "#1d446e"],
    "diverging": ["#225994", "#5078a7", "#7b97b9", "#b8b5aa", "#bf8091", "#ac5571", "#972552"],
    "status": { "good": "#4e7a30", "bad": "#b0453b", "neutral": "#87867f" },
    "validation": {
      "tool": "dataviz validate_palette.js (OKLab), surfaces #ffffff (plot) and #f5f4ed (card)",
      "categorical": "sky/fig/amber: all checks pass on both surfaces; worst all-pairs CVD ΔE 12.5 (deutan, amber↔fig), normal vision 20.1; every color ≥ 3:1 on the plot. Lines are always end-labeled, labels use the darker text step (≥ 4.9:1)",
      "comparison": "#b0aea5 dashed 2px: vs sky CVD 16.0 / normal 18.7, vs fig 18.5 / 24.7, vs amber 14.8 / 15.3; 2.0:1 on white, so it is always dashed and labeled",
      "sequential": "one hue (sky), monotone lightness, every step ≥ 0.06 ΔL, light end 2.14:1 on white",
      "diverging": "sky and fig arms each pass the ordinal checks; poles ΔE 11.9 (CVD) / 21.7; neutral midpoint #b8b5aa"
    }
  },

  "typography": {
    "serif": { "en": "Source Serif 4", "ko": "Noto Serif KR", "weights": [400, 500], "role": "the run-in statement after its bold lead sentence, Key findings bullets" },
    "sans":  { "en": "Inter", "ko": "Noto Sans KR", "weights": [400, 500, 600, 700], "role": "everything else: titles 600–700, labels, numbers, charts" },
    "mono":  { "family": "JetBrains Mono", "weights": [400, 500], "role": "figure and table labels, section numbers, report id" },
    "links": {
      "google": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+KR:wght@400;500;600;700&family=Noto+Serif+KR:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&display=swap"
    },
    "scale": {
      "statementLead": { "size": "clamp(23px, 2.6vw, 36px)", "weight": 600, "lineHeight": 1.28, "letterSpacing": "-0.012em", "family": "sans" },
      "statement":     { "size": "clamp(23px, 2.6vw, 36px)", "weight": 400, "lineHeight": 1.28, "letterSpacing": "-0.01em", "family": "serif" },
      "sectionTitle":  { "size": "19px", "weight": 700, "lineHeight": 1.3, "family": "sans" },
      "cardTitle":     { "size": "21px", "weight": 700, "lineHeight": 1.25, "family": "sans" },
      "figureTitle":   { "size": "17px", "weight": 600, "lineHeight": 1.3, "family": "sans" },
      "keyFigure":     { "size": "17px", "weight": 600, "family": "sans" },
      "findings":      { "size": "16px", "weight": 400, "lineHeight": 1.5, "family": "serif" },
      "body":          { "size": "14px", "weight": 400, "lineHeight": 1.5, "family": "sans" },
      "table":         { "size": "13.5px", "weight": 400, "family": "sans" },
      "meta":          { "size": "13px", "weight": 400, "letterSpacing": "0.01em", "family": "sans" },
      "caption":       { "size": "12.5px", "weight": 400, "lineHeight": 1.5, "family": "sans" },
      "endLabel":      { "size": "12px", "weight": 600, "family": "sans" },
      "axis":          { "size": "11px", "weight": 400, "family": "sans" },
      "figureLabel":   { "size": "11px", "weight": 400, "letterSpacing": "0.1em", "transform": "uppercase", "family": "mono" }
    }
  },

  "radius": { "card": "16px", "plot": "12px", "button": "10px", "pill": "999px", "tooltip": "8px", "badge": "4px" },
  "spacing": { "page": "32px", "gap": "16px", "card": "28px", "row": "10px 0", "footer": "26px 32px 28px" },
  "layout": { "maxWidth": "1400px", "columns": 12, "header": "84px", "breakpoints": { "wide": 1360, "split": 1200, "mid": 1024, "narrow": 900, "phone": 640 } },
  "motion": { "ease": "cubic-bezier(.165,.84,.44,1)", "button": "0.22s", "draw": "1.1s", "fade": "0.45s" },

  "tools": {
    "tableau": { "palettes": "anthropic.tps", "fonts": "Tableau Book for text, Source Serif 4 only if installed on the server; titles bold, figures regular" },
    "powerbi": { "theme": "powerbi-theme.json", "fontFamily": "Inter", "fallback": "Segoe UI" },
    "web": { "css": "tokens.css" }
  }
}
