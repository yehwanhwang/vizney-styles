    <color-palette name="Dyson style — Categorical" type="regular">
      <color>#6b46c1</color>
      <color>#1a8a6e</color>
      <color>#c26a12</color>
      <color>#d9dbdd</color>
      <color>#555555</color>
    </color-palette>
    <color-palette name="Dyson style — Sequential" type="ordered-sequential">
      <color>#b3a0e9</color>
      <color>#977cdb</color>
      <color>#7d5fcf</color>
      <color>#6b46c1</color>
      <color>#4b2d91</color>
    </color-palette>
    <color-palette name="Dyson style — Diverging" type="ordered-diverging">
      <color>#2a64b0</color>
      <color>#5b8bd4</color>
      <color>#8fb0e4</color>
      <color>#e3e3e3</color>
      <color>#ec9aa1</color>
      <color>#d9555f</color>
      <color>#a8142c</color>
