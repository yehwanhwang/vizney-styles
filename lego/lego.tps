<!-- LEGO® style · VIZNEY STYLES · 08. Paste the color-palette elements into My Tableau Repository/Preferences.tps
     (inside <preferences>) and restart Tableau Desktop. Generated by tools/package.py from tokens.json. -->
<workbook>
  <preferences>
    <color-palette name="LEGO® style — Categorical" type="regular">
      <color>#1e5aa8</color>
      <color>#e05a00</color>
      <color>#f7c600</color>
      <color>#a3a3a3</color>
      <color>#8a8a8a</color>
    </color-palette>
    <color-palette name="LEGO® style — Sequential" type="ordered-sequential">
      <color>#89b5f2</color>
      <color>#6f9edf</color>
      <color>#5587cd</color>
      <color>#3a70ba</color>
      <color>#1e5aa8</color>
    </color-palette>
    <color-palette name="LEGO® style — Diverging" type="ordered-diverging">
      <color>#e05a00</color>
      <color>#ea7f4e</color>
      <color>#f3a07d</color>
      <color>#e8e8e8</color>
      <color>#89b5f2</color>
      <color>#5587cd</color>
      <color>#1e5aa8</color>
